{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BIOZAR",
  "version": "1.2.0",
  "identifier": "mg.biozar.app",

  "build": {
    "frontendDist": "../../biozar/web",
    "beforeBuildCommand": "npm --prefix ../../ run gen:sql",
    "beforeDevCommand": ""
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BIOZAR — Console de Pilotage",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co"
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Business",
    "shortDescription": "Console de pilotage BIOZAR — ferme bio de contre-saison, Madagascar",
    "longDescription": "Application semi-offline : fonctionne à 100% sans connexion, synchronise les saisies vers le serveur dès qu'un accès réseau est détecté.",
    "publisher": "BIOZAR Madagascar",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },

  "plugins": {
    "sql": {
      "preload": ["sqlite:biozar.db"]
    }
  }
}
