{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions minimales du shell BIOZAR : base SQL locale + accès HTTP au serveur de synchronisation.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select"
  ]
}
